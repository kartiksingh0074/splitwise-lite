generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique @db.Citext
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime  @default(now())

  refreshTokens        RefreshToken[]
  groupsCreated        Group[]
  groupMemberships     GroupMember[]
  groupInvitesCreated  GroupInvite[]  @relation("GroupInviteCreatedBy")
  groupInvitesUsed     GroupInvite[]  @relation("GroupInviteUsedBy")
  expensesCreated      Expense[]      @relation("ExpenseCreatedBy")
  expensePayments      ExpensePayer[] @relation("ExpensePayerUser")
  expenseShares        ExpenseSplit[] @relation("ExpenseSplitUser")
  ledgerEntries        LedgerEntry[]  @relation("LedgerEntryUser")
  ledgerCounterparty   LedgerEntry[]  @relation("LedgerEntryCounterparty")
  activities           Activity[]     @relation("ActivityActor")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum GroupRole {
  OWNER
  MEMBER
}

model Group {
  id           String    @id @db.Uuid
  name         String
  baseCurrency String    @db.Char(3)
  createdById  String    @db.Uuid
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  members       GroupMember[]
  invites       GroupInvite[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
  activities    Activity[]
}

model GroupMember {
  groupId  String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id])
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id])
  role     GroupRole
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([groupId, userId])
}

model GroupInvite {
  id          String    @id @db.Uuid
  groupId     String    @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  code        String    @unique
  createdById String    @db.Uuid
  createdBy   User      @relation("GroupInviteCreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedById    String?   @db.Uuid
  usedBy      User?     @relation("GroupInviteUsedBy", fields: [usedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([groupId])
}

enum SplitType {
  EQUAL
  EXACT
  PERCENT
  SHARES
}

model Expense {
  id              String    @id @db.Uuid
  groupId         String    @db.Uuid
  group           Group     @relation(fields: [groupId], references: [id])
  description     String
  category        String?
  currency        String    @db.Char(3)
  amountMinor     BigInt
  fxRateToBase    Decimal   @db.Decimal(18, 8)
  amountBaseMinor BigInt
  splitType       SplitType
  paidAt          DateTime
  createdById     String    @db.Uuid
  createdBy       User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  version         Int       @default(1)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payers ExpensePayer[]
  splits ExpenseSplit[]

  @@index([groupId, createdAt])
}

model ExpensePayer {
  expenseId       String  @db.Uuid
  expense         Expense @relation(fields: [expenseId], references: [id])
  userId          String  @db.Uuid
  user            User    @relation("ExpensePayerUser", fields: [userId], references: [id])
  amountMinor     BigInt
  amountBaseMinor BigInt

  @@id([expenseId, userId])
}

model ExpenseSplit {
  expenseId       String   @db.Uuid
  expense         Expense  @relation(fields: [expenseId], references: [id])
  userId          String   @db.Uuid
  user            User     @relation("ExpenseSplitUser", fields: [userId], references: [id])
  shareInput      Decimal? @db.Decimal(18, 8)
  amountMinor     BigInt
  amountBaseMinor BigInt

  @@id([expenseId, userId])
}

enum LedgerSourceType {
  EXPENSE
  EXPENSE_REVERSAL
  SETTLEMENT
  SETTLEMENT_REVERSAL
}

model LedgerEntry {
  id              String           @id @db.Uuid
  groupId         String           @db.Uuid
  group           Group            @relation(fields: [groupId], references: [id])
  userId          String           @db.Uuid
  user            User             @relation("LedgerEntryUser", fields: [userId], references: [id])
  counterpartyId  String?          @db.Uuid
  counterparty    User?            @relation("LedgerEntryCounterparty", fields: [counterpartyId], references: [id])
  amountBaseMinor BigInt
  sourceType      LedgerSourceType
  sourceId        String           @db.Uuid
  createdAt       DateTime         @default(now())

  @@index([groupId, userId])
  @@index([sourceId])
}

model Activity {
  id         String   @id @db.Uuid
  groupId    String   @db.Uuid
  group      Group    @relation(fields: [groupId], references: [id])
  actorId    String   @db.Uuid
  actor      User     @relation("ActivityActor", fields: [actorId], references: [id])
  type       String
  entityType String
  entityId   String   @db.Uuid
  payload    Json
  createdAt  DateTime @default(now())

  @@index([groupId, createdAt])
}
