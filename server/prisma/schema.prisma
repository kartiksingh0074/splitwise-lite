generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique @db.Citext
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime  @default(now())

  refreshTokens        RefreshToken[]
  groupsCreated        Group[]
  groupMemberships     GroupMember[]
  groupInvitesCreated  GroupInvite[] @relation("GroupInviteCreatedBy")
  groupInvitesUsed     GroupInvite[] @relation("GroupInviteUsedBy")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum GroupRole {
  OWNER
  MEMBER
}

model Group {
  id           String    @id @db.Uuid
  name         String
  baseCurrency String    @db.Char(3)
  createdById  String    @db.Uuid
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  members GroupMember[]
  invites GroupInvite[]
}

model GroupMember {
  groupId  String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id])
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id])
  role     GroupRole
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([groupId, userId])
}

model GroupInvite {
  id          String    @id @db.Uuid
  groupId     String    @db.Uuid
  group       Group     @relation(fields: [groupId], references: [id])
  code        String    @unique
  createdById String    @db.Uuid
  createdBy   User      @relation("GroupInviteCreatedBy", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedById    String?   @db.Uuid
  usedBy      User?     @relation("GroupInviteUsedBy", fields: [usedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([groupId])
}
